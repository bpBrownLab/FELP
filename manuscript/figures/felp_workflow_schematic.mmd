%%{init: {
  'theme': 'base',
  'themeVariables': {
    'fontFamily': 'Helvetica, Arial, sans-serif',
    'fontSize': '13px',
    'primaryColor': '#f7f9fc',
    'primaryTextColor': '#1a1a1a',
    'primaryBorderColor': '#2c5282',
    'lineColor': '#4a5568'
  },
  'flowchart': {'curve': 'basis', 'padding': 16}
}}%%

flowchart TB
  classDef stage fill:#2c5282,stroke:#1a365d,color:#fff,font-weight:bold;
  classDef input fill:#ebf8ff,stroke:#2b6cb0,color:#1a202c;
  classDef process fill:#f7fafc,stroke:#4a5568,color:#1a202c;
  classDef rosetta fill:#fffaf0,stroke:#c05621,color:#1a202c;
  classDef openmm fill:#f0fff4,stroke:#276749,color:#1a202c;
  classDef reweight fill:#faf5ff,stroke:#6b46c1,color:#1a202c;
  classDef optional fill:#faf5ff,stroke:#9f7aea,color:#553c9a,stroke-dasharray:4 4;

  subgraph S1["Stage 1 · Reference ensemble & microstates"]
    MD["Reference MD trajectory"]:::input
    MS["Microstate atlas<br/>grid · file · MSM"]:::process
    MD --> MS
  end

  subgraph S2["Stage 2 · Assignment & π₀"]
    ASSIGN["Measure CVs · assign state i · π₀(i)"]:::process
    MS --> ASSIGN
  end

  subgraph S3["Stage 3 · Symmetric restrained perturbation (per frame)"]
    CONV["ParmEd → PyRosetta pose"]:::process
    REST["Reference-frame restraints"]:::process
    subgraph SYM["Symmetric PyRosetta branches (same relax/repack protocol)"]
      REFM["Reference: enforce/mutate<br/>original identity"]:::rosetta
      PERTM["Perturbed: mutate<br/>target residue"]:::rosetta
    end
    subgraph OMM["OpenMM reweighting Hamiltonian"]
      FF["ff14SBonlysc + GBNeck2"]:::openmm
      U0["Restrained min → U₀"]:::openmm
      U1["Restrained min → U₁"]:::openmm
      DU["ΔU = U₁ − U₀"]:::openmm
    end
    CONV --> REST --> REFM
    REST --> PERTM
    REFM --> U0
    PERTM --> U1
    U0 --> FF
    U1 --> FF
    FF --> DU
  end

  subgraph S4["Stage 4 · State-local reweighting"]
    FI["fᵢ = ⟨exp(−βΔU)⟩₀,ᵢ · ESS/QC"]:::reweight
    POOL["Optional: neighbor pool + L-curve τ<br/>fᵢ^blend"]:::optional
    PI["π₁(i) ∝ π₀(i) fᵢ or fᵢ^blend"]:::reweight
    OUT["F₁(i) · landscape · diagnostics"]:::input
    ASSIGN --> CONV
    DU --> FI
    FI --> POOL
    POOL --> PI
    FI -. default: independent .-> PI
    PI --> OUT
  end

  class S1,S2,S3,S4 stage
