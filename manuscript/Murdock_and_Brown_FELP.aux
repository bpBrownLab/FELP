\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {Free Energy Landscape Perturbation workflow.} A reference MD ensemble is partitioned into microstates in a chosen collective-variable space. Reference-to-perturbed energy differences are evaluated for sampled structures within each state. State-specific exponential averages reweight the reference probabilities to estimate the perturbed landscape. Overlap diagnostics audit whether the predicted population shift is supported by the reference ensemble.\relax }}{5}{figure.caption.4}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:FELPWorkflow}{{1}{5}{\textbf {Free Energy Landscape Perturbation workflow.} A reference MD ensemble is partitioned into microstates in a chosen collective-variable space. Reference-to-perturbed energy differences are evaluated for sampled structures within each state. State-specific exponential averages reweight the reference probabilities to estimate the perturbed landscape. Overlap diagnostics audit whether the predicted population shift is supported by the reference ensemble.\relax }{figure.caption.4}{}}
