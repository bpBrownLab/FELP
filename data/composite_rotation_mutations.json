    "top_margin": 0.94,
    "bottom_margin": 0.07,
    "row_label_pad": 0.075,
    "column_header_pad": 0.015,
    "colorbar_mode": "every_panel",
    "row_label_rotation": -90,
    "fel_colorbar_label": "Free energy (kcal/mol)",
    "kl_colorbar_label": "",
